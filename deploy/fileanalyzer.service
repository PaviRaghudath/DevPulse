[Unit]
Description=FileAnalyzer Streamlit App
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/fileanalyzer
EnvironmentFile=/opt/fileanalyzer/.env
ExecStart=/opt/fileanalyzer/.venv/bin/python -m streamlit run app.py \
    --server.port=8501 \
    --server.address=127.0.0.1 \
    --server.headless=true \
    --server.fileWatcherType=none
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target

# Copy this file to .env and set your API key(s).
# You only need one — whichever provider you choose in the UI.

# OpenAI (ChatGPT) — get key at https://platform.openai.com
OPENAI_API_KEY=your_openai_key_here

# Anthropic (Claude) — get key at https://console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_key_here

# Suppress ChromaDB telemetry warnings
ANONYMIZED_TELEMETRY=False

# Optional tuning overrides
# CHUNK_SIZE=512
# CHUNK_OVERLAP=64
# EMBEDDING_MODEL=all-MiniLM-L6-v2
# TOP_K_RETRIEVAL=6
